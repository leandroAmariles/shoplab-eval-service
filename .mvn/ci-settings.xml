<?xml version="1.0" encoding="UTF-8"?>
<!-- Used by CI and Dockerfile to download shoplab-contracts and chat stubs from GitHub Packages, and to deploy
     eval stubs. No credential lives here: the token is read from the environment. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
    <servers>
        <server>
            <id>github</id>
            <username>x-access-token</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
        <server>
            <id>github-shoplab-contracts</id>
            <username>x-access-token</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
        <server>
            <id>github-shoplab-chat</id>
            <username>x-access-token</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
    </servers>
</settings>
